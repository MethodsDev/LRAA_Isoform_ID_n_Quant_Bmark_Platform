# Python/runtime noise
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# External input payloads
.benchmark_inputs/
**/raw_prog_results/*
!**/raw_prog_results/.gitkeep
**/processed_prog_results/*
!**/processed_prog_results/.gitkeep
**/reference_data/*
!**/reference_data/.gitkeep

# Generated benchmark outputs
*.tsv
*.tsv.gz
*.tab
*.quant
*.counts
*.gtf
*.gff
*.gff3
*.fa
*.fasta
*.fq
*.fastq
*.bam
*.bai
*.pdf
# Publish the paper-facing benchmark PDFs linked from the README.
!QUANT_ONLY/*/*summary*.latest_tools.pdf
!DENOVO_ID/*/*summary*.latest_tools.pdf
!REF_Guided/*/*summary*.latest_tools.pdf
!DENOVO_ID/*/*_F1_by_error_rate.latest_tools.pdf
!REF_Guided/*/*_F1_by_error_rate.latest_tools.pdf
!QUANT_ONLY/MORFs/combined_morf_quant_plot.latest_tools.pdf
!QUANT_ONLY/SG-NEx/SGNex_expr_cor_plot.latest_tools.pdf
!DENOVO_ID/MORFs/combined_morf_denovo_plot.latest_tools.pdf
!DENOVO_ID/SG-NEx/SG-NEx_cell_lines_denovo_stacked.latest_tools.pdf
!REF_Guided/MORFs/MORFs_refGuided_plot.latest_tools.pdf
!REF_Guided/SG-NEx/SG-NEx_cell_lines_stacked.latest_tools.pdf
*.png
# Keep figures referenced by rendered GitHub documents trackable.
!**/*_files/figure-gfm/*.png
*.html
*.log
*.files.list
cluster_assignments.csv
correlation_matrix.csv
expression_matrix.csv
cor_files.list
bmark.ok
script.log

# Executed notebooks are generated in sample directories.
*.ipynb
!benchmarking/template_notebooks/*.ipynb

# Paper supplementary analyses, tables and data-generation notebooks are tracked as published.
!supp_analyses/**
!supp_tables/**
!data_generation/**
